# Clerk — the same application the Flutter app signs into, so an account made
# on the phone is the account the extension connects to.
# Dashboard -> API keys.
#
# Note the shape of the placeholders. A realistic-looking dummy here —
# sk_test_ followed by twenty-odd alphanumerics — is indistinguishable from a
# Stripe test key to GitHub's secret scanner, and blocks the push. Keep the
# angle brackets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<from the Clerk dashboard>
CLERK_SECRET_KEY=sk_test_<from the Clerk dashboard>

# The Convex deployment that holds the subscription mirror — the .convex.cloud
# URL, the same one the Flutter app's CONVEX_URL points at.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-123.convex.cloud

# Which browser extensions are allowed to receive an account token from
# /extension/connect, as a comma-separated list of origins.
#
# Chrome gives an extension the redirect origin
# https://<extension-id>.chromiumapp.org — and the id of an unpacked
# development build is not the id of the published one, so this is normally
# both. Find the id at chrome://extensions.
#
# Nothing outside this list is ever sent a token: see safeRedirectTarget in
# src/lib/extension.ts.
EXTENSION_REDIRECT_ORIGINS=https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.chromiumapp.org
